APP_NAME=BookSpace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Africa/Ouagadougou

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bookspace
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Photos des espaces et des profils : public (dev, `php artisan storage:link`) | s3 (prod)
PHOTOS_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── BookSpace ──────────────────────────────────────────────────────────────
# Taux plateforme (voir aussi la table `parametres`, prioritaire si définie)
PLATFORM_COMMISSION_RATE=10
BOOKING_DEPOSIT_RATE=30
BOOKING_CANCEL_HOURS=24
# Délai (min) de règlement de l'acompte avant expiration de la réservation
RESERVATION_EXPIRE_MINUTES=30
# Sursis (minutes) d'un paiement lancé mais non abouti avant expiration
PAIEMENT_EXPIRE_MINUTES=60

# Passerelle Mobile Money : fake (dev, validé automatiquement) | tout autre
# valeur = passerelle réelle (mode envoyé par PaiementService, toujours "yenga")
MOMO_DRIVER=fake
# Secret HMAC du webhook opérateur générique /api/paiements/callback.
# Sans secret, les webhooks sont REFUSÉS (503) sauf avec MOMO_DRIVER=fake hors production.
MOMO_WEBHOOK_SECRET=

# Yenga (agrégateur Orange Money/Moov Money/Telecel Money — https://yengapay.com)
# Identifiants du tableau de bord marchand (Group ID, Project ID, Clé API)
YENGA_GROUP_ID=
YENGA_PROJECT_ID=
YENGA_API_KEY=
# Secret du webhook IPN Yenga (en-tête X-Webhook-Hash) pour /api/paiements/callback/yenga — OBLIGATOIRE
# avec MOMO_DRIVER=yenga : sans lui, aucun paiement Yenga ne peut être confirmé.
YENGA_WEBHOOK_SECRET=

# Support affiché dans Profil > Centre d'aide (laisser vide = non affiché)
SUPPORT_EMAIL=contact@bookspace.bf
SUPPORT_TELEPHONE=
SUPPORT_WHATSAPP=
SUPPORT_HORAIRES="Du lundi au samedi, 8 h – 18 h"

# SMS transactionnels : log (dev, écrit dans storage/logs) | africastalking | http
SMS_DRIVER=log
SMS_SENDER=BookSpace
# Africa's Talking (https://africastalking.com) — AT_USERNAME=sandbox pour tester
# gratuitement avant de passer sur un compte production.
AT_USERNAME=
AT_API_KEY=
# Fournisseur HTTP générique alternatif (agrégateur type LeTexto, etc.)
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
